<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChallengePrototype</RootNamespace>
    <AssemblyName>ExamCompanion.Web</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\ExamCompanion.Application\ExamCompanion.Application.csproj" />
    <ProjectReference Include="src\ExamCompanion.Infrastructure\ExamCompanion.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="prototype-main\**\*.cs" />
    <Content Remove="prototype-main\**\*" />
    <None Remove="prototype-main\**\*" />
    <Content Remove="tests\**\*" />
    <Content Remove="src\**\*" />
    <None Remove="src\**\*" />
  </ItemGroup>

</Project>
