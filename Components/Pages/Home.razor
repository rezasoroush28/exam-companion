@page "/"
@page "/lessons"
@inject ChallengeEngine Engine
@inject ChallengeHealthEngine HealthEngine
@implements IAsyncDisposable

<PageTitle>چالش مکعبی</PageTitle>

<div class="game-shell">
    @if (_loading)
    {
        <div class="loading">در حال آماده‌کردن چالش…</div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-card">
            <strong>چالش آماده نشد</strong>
            <span>@_error</span>
            <button @onclick="RestartAsync">تلاش دوباره</button>
        </div>
    }
    else
    {
        <header class="hud" aria-label="وضعیت بازی">
            <div class="hud-lesson">
                <span>درس</span>
                <strong>@Engine.LessonTitle</strong>
            </div>
            <div><span>سطح</span><strong class="difficulty @Engine.CurrentDifficulty.CssName()">@Engine.CurrentDifficulty.Label()</strong></div>
            <div><span>پیشرفت</span><strong>@Math.Min(Engine.QuestionsAnswered, Engine.LevelTargetCount) / @Engine.LevelTargetCount</strong></div>
            <div><span>شواهد</span><strong>@Engine.QuestionsAnswered / @Engine.MinimumEvidenceRequired</strong></div>
        </header>

        <HealthBar @ref="_healthBar" Health="_health" Delta="_healthDelta" Difficulty="Engine.CurrentDifficulty"
                   PulseKey="_healthPulse" IsCorrectFeedback="_lastAnswerCorrect" IsLevelComplete="_levelCompleting" />

        <section class="challenge-frame" aria-label="محفظه چالش">
            <div class="board-glow"></div>
            <div class="game-board">
                <GameBoard @ref="_gameBoard" CubeSettled="HandleCubeSettledAsync"
                           IncorrectCubeRemoved="HandleIncorrectRemovedAsync"
                           VacuumStarted="HandleVacuumStartedAsync"
                           CorrectCubeCollected="HandleCorrectCollectedAsync"
                           ResultPhysicsCompleted="HandleResultCompletedAsync"
                           IsDevelopment="@IsDevelopment" />

                @if (_showBonus)
                {
                    <div class="bonus-hud @(_completed ? "final" : "")">
                        <span>@(_completed ? "TOTAL BONUS" : "BONUS")</span>
                        <strong>@_totalBonus</strong>
                        @if (_floatingBonus > 0)
                        {
                            <b @key="_bonusPulse">+@_floatingBonus</b>
                        }
                    </div>
                }

                @if (_questionVisible && _question is not null)
                {
                    <div class="question-layer @(_feedbackShown ? "feedback" : "")">
                        <article class="question-card">
                            <div class="question-meta">
                                <span>@_question.Topic.Title</span>
                                <span>@_question.RequestedDifficulty.Label()</span>
                            </div>
                            <div class="question-text">@((MarkupString)_question.TitleHtml)</div>
                            <div class="answers">
                                @foreach (var option in _question.Options)
                                {
                                    var state = OptionState(option.Option);
                                    <button class="answer @state" disabled="@(_answerLocked || !_questionActive || _healthDepleted)" @onclick="() => AnswerAsync(option.Option)">
                                        <span class="option-key">@OptionLetter(option.Option)</span>
                                        <span>@((MarkupString)option.Html)</span>
                                        @if (IsDevelopment && option.Option == _question.CorrectOption)
                                        {
                                            <small class="test-answer-key">پاسخ صحیح</small>
                                        }
                                    </button>
                                }
                            </div>
                            @if (_feedbackShown)
                            {
                                <div class="answer-feedback @(_lastAnswerCorrect ? "is-correct" : "is-incorrect")">
                                    @(_lastAnswerCorrect ? "درست بود ✓" : "نادرست بود ×")
                                </div>
                            }
                        </article>
                    </div>
                }

                @if (_completed)
                {
                    <div class="complete-card">
                        <span>نتیجه چالش کامل شد</span>
                        <strong>امتیاز نهایی: @_totalBonus</strong>
                        <button @onclick="RestartAsync">شروع دوباره همین چالش</button>
                    </div>
                }

                @if (_levelCompleting)
                {
                    <div class="level-complete"><span>سطح کامل شد</span><strong>@_completedLevel.Label()</strong></div>
                }

            </div>
        </section>

        @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
        {
            <div class="result-debug">
                <span>@_resultState</span>
                <span>wrong: @_incorrectRemaining</span>
                <span>correct: @_correctRemaining</span>
                <span>bonus: @_totalBonus</span>
                <button @onclick="DebugForceCompletionAsync">پایان آزمایشی</button>
                <button @onclick="DebugRandomizeAnswersAsync">پاسخ‌های تصادفی</button>
                <button @onclick="() => DebugSetAnswersAsync(true)">همه درست</button>
                <button @onclick="() => DebugSetAnswersAsync(false)">همه غلط</button>
                <button @onclick="ToggleWireframesAsync">wireframe</button>
                <button @onclick="RestartAsync">بازنشانی</button>
            </div>
        }
    }
</div>

@code {
    private CancellationTokenSource _lifetime = new();
    private GameBoard? _gameBoard;
    private HealthBar? _healthBar;
    private ChallengeQuestion? _question;
    private long _activeCubeId;
    private long _cubeSequence;
    private bool _loading = true;
    private bool _questionVisible;
    private bool _answerLocked;
    private bool _feedbackShown;
    private bool _lastAnswerCorrect;
    private bool _completed;
    private bool _questionActive;
    private bool _healthDepleted;
    private bool _levelCompleting;
    private GameDifficulty _completedLevel;
    private double _health;
    private double? _healthDelta;
    private int _healthPulse;
    private CancellationTokenSource? _healthDepletion;
    private readonly HashSet<long> _healthAppliedCubeIds = [];
    private bool _resultStarted;
    private bool _showBonus;
    private int _totalBonus;
    private int _floatingBonus;
    private int _bonusPulse;
    private string _resultState = "ChallengeActive";
    private int _incorrectRemaining;
    private int _correctRemaining;
    private bool _wireframes;
    private readonly List<ResultCube> _resultCubes = [];
    private readonly HashSet<long> _collectedCubeIds = [];
    private string? _selectedOption;
    private string? _error;
    private static bool IsDevelopment => Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development";

    protected override async Task OnInitializedAsync() => await RestartAsync();

    private async Task RestartAsync()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        _lifetime = new CancellationTokenSource();
        _loading = true;
        _error = null;
        _completed = false;
        CancelHealthDepletion();
        _health = HealthEngine.Options.StartingHealth;
        _healthDelta = null;
        _healthDepleted = false;
        _questionActive = false;
        _healthAppliedCubeIds.Clear();
        _levelCompleting = false;
        _resultStarted = false;
        _showBonus = false;
        _totalBonus = 0;
        _floatingBonus = 0;
        _resultState = "ChallengeActive";
        _resultCubes.Clear();
        _collectedCubeIds.Clear();
        _questionVisible = false;
        try
        {
            if (_gameBoard is not null)
                await _gameBoard.ResetAsync();
            await Engine.InitializeAsync(_lifetime.Token);
            _loading = false;
            await InvokeAsync(StateHasChanged);
            if (_healthBar is not null)
                await _healthBar.SetHealthAsync(_health, true);
            await Task.Delay(GameTiming.InitialPauseMs, _lifetime.Token);
            await DropNextAsync(_lifetime.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    private async Task DropNextAsync(CancellationToken token)
    {
        _question = await Engine.NextQuestionAsync();
        if (_question is null)
        {
            await StartResultSequenceAsync();
            return;
        }

        _activeCubeId = ++_cubeSequence;
        _selectedOption = null;
        _feedbackShown = false;
        _answerLocked = false;
        _questionActive = false;
        _healthDelta = null;
        _questionVisible = false;
        await InvokeAsync(StateHasChanged);
        if (_gameBoard is null) throw new InvalidOperationException("صفحه فیزیک آماده نیست.");
        await _gameBoard.SpawnCubeAsync(_activeCubeId, _question);
    }

    private async Task HandleCubeSettledAsync(GameBoard.CubeSettledPayload payload)
    {
        if (_question is null || payload.CubeId != _activeCubeId || payload.QuestionId != _question.Id) return;
        _questionVisible = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(220, _lifetime.Token);
        if (_question is null || payload.CubeId != _activeCubeId || _answerLocked || _healthDepleted) return;
        _questionActive = true;
        await InvokeAsync(StateHasChanged);
        await BeginHealthTimingAsync(_question);
    }

    private async Task AnswerAsync(string option)
    {
        if (_answerLocked || !_questionActive || _healthDepleted || _question is null || _gameBoard is null || _healthBar is null) return;
        _answerLocked = true;
        _questionActive = false;
        CancelHealthDepletion();
        var activeElapsed = TimeSpan.FromMilliseconds(await _healthBar.StopQuestionAsync());
        if (!_healthAppliedCubeIds.Add(_activeCubeId)) return;
        _selectedOption = option;
        _lastAnswerCorrect = option == _question.CorrectOption;
        var importanceTier = BonusConfiguration.ImportanceTier(_question.Topic.Importance);
        Engine.RecordAnswer(_question.Topic.Id, _lastAnswerCorrect);
        var healthResult = HealthEngine.ApplyAnswer(_health, activeElapsed,
            Engine.CurrentDifficulty, importanceTier, _lastAnswerCorrect, Engine.TotalGainWeight, Engine.IsEvidenceGateOpen);
        _health = healthResult.NewHealth;
        _healthDelta = healthResult.SignedDelta;
        _healthPulse++;
        await _healthBar.SetHealthAsync(_health, _lastAnswerCorrect);
        await _gameBoard.MarkAnswerAsync(_activeCubeId, _lastAnswerCorrect);
        _resultCubes.Add(new ResultCube(_activeCubeId, _question.Id, _question.Topic.Id,
            importanceTier,
            _question.RequestedDifficulty, _lastAnswerCorrect));
        _feedbackShown = true;
        _healthDepleted = healthResult.IsDepleted;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(GameTiming.FeedbackMs, _lifetime.Token);
        if (_healthDepleted)
        {
            _questionVisible = false;
            await InvokeAsync(StateHasChanged);
            await StartResultSequenceAsync();
            return;
        }
        if (healthResult.IsFull && Engine.IsEvidenceGateOpen)
        {
            _questionVisible = false;
            await CompleteLevelAsync();
            return;
        }
        _questionVisible = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(GameTiming.BetweenQuestionsMs, _lifetime.Token);
        await DropNextAsync(_lifetime.Token);
    }

    private async Task CompleteLevelAsync()
    {
        _completedLevel = Engine.CurrentDifficulty;
        _levelCompleting = true;
        _resultState = "LevelCompletion";
        if (_healthBar is not null) await _healthBar.PlayLevelCompleteAsync();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(900, _lifetime.Token);
        _levelCompleting = false;
        if (!Engine.AdvanceLevel())
        {
            await StartResultSequenceAsync();
            return;
        }
        _health = HealthEngine.Options.StartingHealth;
        _healthDelta = null;
        _resultState = "PreparingNextLevel";
        if (_healthBar is not null) await _healthBar.SetHealthAsync(_health, true);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(GameTiming.BetweenQuestionsMs, _lifetime.Token);
        await DropNextAsync(_lifetime.Token);
    }

    private async Task StartResultSequenceAsync()
    {
        if (_resultStarted || _gameBoard is null) return;
        CancelHealthDepletion();
        if (_healthBar is not null) await _healthBar.StopQuestionAsync();
        _resultStarted = true;
        _resultState = "ChallengeFinished";
        _incorrectRemaining = _resultCubes.Count(x => !x.IsCorrect);
        _correctRemaining = _resultCubes.Count(x => x.IsCorrect);
        await InvokeAsync(StateHasChanged);
        await _gameBoard.StartResultSequenceAsync(_resultCubes);
    }

    private Task HandleIncorrectRemovedAsync(long cubeId)
    {
        _incorrectRemaining = Math.Max(0, _incorrectRemaining - 1);
        _resultState = _incorrectRemaining == 0 ? "WaitingForIncorrectCubesToExit" : "DroppingIncorrectCubes";
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleVacuumStartedAsync()
    {
        _resultState = "VacuumActive";
        _showBonus = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleCorrectCollectedAsync(long cubeId)
    {
        if (!_collectedCubeIds.Add(cubeId)) return;
        var cube = _resultCubes.FirstOrDefault(x => x.CubeId == cubeId && x.IsCorrect);
        if (cube is null) return;
        var bonus = BonusConfiguration.Calculate(cube);
        _resultState = "BonusUpdating";
        _floatingBonus = bonus;
        _bonusPulse++;
        _totalBonus += bonus;
        _correctRemaining = Math.Max(0, _correctRemaining - 1);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleResultCompletedAsync()
    {
        _resultState = "ResultComplete";
        _showBonus = true;
        _floatingBonus = 0;
        _completed = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DebugForceCompletionAsync()
    {
        if (!IsDevelopment || _resultStarted || _gameBoard is null) return;
        if (_question is not null && _resultCubes.All(x => x.CubeId != _activeCubeId))
        {
            var correct = Random.Shared.Next(2) == 0;
            await _gameBoard.MarkAnswerAsync(_activeCubeId, correct);
            _resultCubes.Add(new ResultCube(_activeCubeId, _question.Id, _question.Topic.Id,
                BonusConfiguration.ImportanceTier(_question.Topic.Importance), _question.RequestedDifficulty, correct));
            Engine.RecordAnswer(_question.Topic.Id, correct);
        }
        _questionVisible = false;
        await StartResultSequenceAsync();
    }

    private async Task DebugRandomizeAnswersAsync()
    {
        if (!IsDevelopment || _resultStarted || _gameBoard is null) return;
        for (var index = 0; index < _resultCubes.Count; index++)
        {
            var existing = _resultCubes[index];
            var randomized = existing with { IsCorrect = Random.Shared.Next(2) == 0 };
            _resultCubes[index] = randomized;
            await _gameBoard.MarkAnswerAsync(randomized.CubeId, randomized.IsCorrect);
        }
    }

    private async Task DebugSetAnswersAsync(bool correct)
    {
        if (!IsDevelopment || _resultStarted || _gameBoard is null) return;
        for (var index = 0; index < _resultCubes.Count; index++)
        {
            var updated = _resultCubes[index] with { IsCorrect = correct };
            _resultCubes[index] = updated;
            await _gameBoard.MarkAnswerAsync(updated.CubeId, correct);
        }
        if (_question is not null && _resultCubes.All(x => x.CubeId != _activeCubeId))
        {
            await _gameBoard.MarkAnswerAsync(_activeCubeId, correct);
            _resultCubes.Add(new ResultCube(_activeCubeId, _question.Id, _question.Topic.Id,
                BonusConfiguration.ImportanceTier(_question.Topic.Importance), _question.RequestedDifficulty, correct));
            Engine.RecordAnswer(_question.Topic.Id, correct);
            _questionVisible = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleWireframesAsync()
    {
        if (_gameBoard is null) return;
        _wireframes = !_wireframes;
        await _gameBoard.SetWireframesAsync(_wireframes);
    }

    private async Task BeginHealthTimingAsync(ChallengeQuestion question)
    {
        if (_healthBar is null || _healthDepleted) return;
        CancelHealthDepletion();
        var importance = BonusConfiguration.ImportanceTier(question.Topic.Importance);
        var decay = HealthEngine.GetTimeDecayPerSecond(Engine.CurrentDifficulty, importance);
        await _healthBar.BeginQuestionAsync(_health, decay, HealthEngine.GetGracePeriodMs(Engine.CurrentDifficulty));
        _healthDepletion = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _ = MonitorHealthDepletionAsync(_activeCubeId, Engine.CurrentDifficulty, importance, _healthDepletion.Token);
    }

    private async Task MonitorHealthDepletionAsync(long cubeId, GameDifficulty difficulty, int importance, CancellationToken token)
    {
        if (_healthBar is null) return;
        var expected = HealthEngine.GetTimeToDepletion(_health, difficulty, importance);
        try
        {
            await Task.Delay(expected, token);
            while (!token.IsCancellationRequested && _questionActive && _activeCubeId == cubeId)
            {
                try
                {
                    var elapsed = TimeSpan.FromMilliseconds(await _healthBar.GetActiveElapsedMsAsync());
                    var loss = HealthEngine.GetTimeLoss(elapsed, difficulty, importance);
                    if (loss >= _health)
                    {
                        _questionActive = false;
                        _answerLocked = true;
                        _healthDepleted = true;
                        _healthDelta = -_health;
                        _health = 0;
                        _healthPulse++;
                        await _healthBar.StopQuestionAsync();
                        await _healthBar.SetHealthAsync(0, false);
                        if (_question is not null && _gameBoard is not null && _resultCubes.All(x => x.CubeId != _activeCubeId))
                        {
                            await _gameBoard.MarkAnswerAsync(_activeCubeId, false);
                            _resultCubes.Add(new ResultCube(_activeCubeId, _question.Id, _question.Topic.Id,
                                BonusConfiguration.ImportanceTier(_question.Topic.Importance),
                                _question.RequestedDifficulty, false));
                            _healthAppliedCubeIds.Add(cubeId);
                            Engine.RecordAnswer(_question.Topic.Id, false);
                        }
                        _questionVisible = false;
                        await InvokeAsync(StateHasChanged);
                        await StartResultSequenceAsync();
                        return;
                    }
                    var remaining = (_health - loss) / HealthEngine.GetTimeDecayPerSecond(difficulty, importance);
                    await Task.Delay(TimeSpan.FromSeconds(Math.Max(.25, remaining)), token);
                }
                catch (JSDisconnectedException)
                {
                    await Task.Delay(1000, token);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private void CancelHealthDepletion()
    {
        if (_healthDepletion is null) return;
        _healthDepletion.Cancel();
        _healthDepletion.Dispose();
        _healthDepletion = null;
    }

    private string OptionState(string option)
    {
        if (!_feedbackShown || _question is null) return _selectedOption == option ? "selected" : "";
        if (option == _question.CorrectOption) return "correct-option";
        return option == _selectedOption ? "wrong-option" : "";
    }

    private static string OptionLetter(string option) => option switch { "1" => "A", "2" => "B", "3" => "C", "4" => "D", _ => option };

    public ValueTask DisposeAsync()
    {
        CancelHealthDepletion();
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
