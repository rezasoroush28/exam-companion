@page "/"
@page "/lessons"
@using ExamCompanion.Application.Music
@using ChallengePrototype.Components.Game
@inject IGameEngine Engine
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>هم‌آهنگ | Exam Companion</PageTitle>
<div class="studio-shell" @ref="_host">
    <header class="studio-header"><a class="brand" href="/"><img src="art/brand/hamahang-mark.svg" alt=""/><span>هم‌آهنگ<small>EXAM COMPANION</small></span></a><span class="header-note">یک استودیوی کوچک برای یادگرفتن</span><span class="edition">VOL. 01</span></header>
    @if (_lesson != null)
    {
        <main class="landing-grid">
            <section class="landing-copy">
                <div class="eyebrow"><span class="live-dot"></span> یادگیری، با ریتم تو</div>
                <h1>یاد بگیر.<br/>یک <em>ملودی</em> بساز.<br/>صدای خودت رو بشنو.</h1>
                <p class="hero-description">هر مبحث یک ملودی‌ست. کشفش کن، نت‌هاش رو کنار هم بذار و آلبوم خودت رو بساز.</p>
                <div class="lesson-picker"><GameIcon/><div><small>آلبوم این سفر</small><strong>@_lesson.Name</strong></div><span class="lesson-track-count">۵ قطعه</span></div>
                <button class="button primary start-game" disabled="@_busy" @onclick="Start"><span>@(_busy ? "در حال ساخت آلبوم…" : "شروع یک ملودی تازه")</span><b>←</b></button>
                @if (_lesson.ResumeSessionId.HasValue) { <a class="resume-link" href="/game/@_lesson.ResumeSessionId">ادامه‌ی آلبوم قبلی <span>↗</span></a> }
                <div class="landing-promise"><span>♪ بدون زمان‌سنج</span><span>✧ فرصت برای دوباره یادگرفتن</span></div>
            </section>
            <section class="landing-art" aria-label="پیش‌نمایش صفحه موسیقی">
                <div class="art-label">A LITTLE LEARNING.<br/>A SOUND OF YOUR OWN.</div>
                <Gramophone Topics="_lesson.Topics" Preview="true"/>
                <div class="disc-caption"><span class="equalizer"><i></i><i></i><i></i><i></i></span><span>صدای دنیای زنده</span><small>۵ مبحث · یک آلبوم</small></div>
            </section>
        </main>
        <section class="how-it-plays"><div><span>01</span><strong>نت‌ها رو کشف کن</strong><p>هر سؤال کوتاه، یک تکه از ملودی تو.</p></div><div><span>02</span><strong>قطعه‌ات رو بساز</strong><p>با یک چالش، نت‌ها رو به هم وصل کن.</p></div><div><span>03</span><strong>دوباره صیقل بده</strong><p>خش‌های کوچک رو با یک تمرین کوتاه پاک کن.</p></div></section>
    }
    else if (_error == null) { <div class="empty-state">♪ در حال کوک‌کردن سازها…</div> }
    @if (_error != null) { <div class="error-notice" role="alert">@_error <button @onclick="Load">تلاش دوباره</button></div> }
    <footer class="studio-footer"><span>ساخته‌شده برای لذتِ فهمیدن</span><span>LEARN A LITTLE. MAKE A LITTLE MAGIC. ✦</span></footer>
</div>
@code {
    private ElementReference _host;
    private LessonDto? _lesson;
    private string? _error;
    private bool _busy, _disposed, _motionInitialized;
    private IJSObjectReference? _motionModule, _motion;
    protected override Task OnInitializedAsync() => Load();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _lesson == null || _motionInitialized) return;
        try
        {
            _motionModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/gameMotion.js");
            _motion ??= await _motionModule.InvokeAsync<IJSObjectReference>("create", _host);
            _motionInitialized = true;
            await _motion.InvokeVoidAsync("initialize", "landing");
            await _motion.InvokeVoidAsync("preview", "prototype-entrance");
        }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            // The page remains usable if presentation-only motion is unavailable.
            _motionInitialized = false;
        }
    }
    private async Task Load() { try { _error = null; _lesson = await Engine.GetLessonAsync(); } catch (Exception) { _error = "آلبوم بارگذاری نشد. لطفاً دوباره امتحان کن."; } }
    private async Task Start()
    {
        if (_busy || _lesson == null) return;
        _busy = true;
        try
        {
            var state = await Engine.StartSessionAsync(_lesson.Id);
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", $"gramophone:enter:{state.SessionId}", "1"); }
            catch (JSException) { }
            Navigation.NavigateTo($"/game/{state.SessionId}");
        }
        catch (Exception) { _error = "شروع بازی ممکن نشد؛ دوباره تلاش کن."; }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_motion != null)
            {
                await _motion.InvokeVoidAsync("dispose");
                await _motion.DisposeAsync();
            }
            if (_motionModule != null) await _motionModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
