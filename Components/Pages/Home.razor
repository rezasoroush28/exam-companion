@page "/"
@page "/lessons"
@using ExamCompanion.Application.Music
@using ChallengePrototype.Components.Game
@inject IGameEngine Engine
@inject NavigationManager Navigation

<PageTitle>هم‌آهنگ | Exam Companion</PageTitle>
<div class="studio-shell">
    <header class="studio-header"><a class="brand" href="/"><span class="brand-star">✦</span><span>هم‌آهنگ<small>EXAM COMPANION</small></span></a><span class="header-note">یک تجربه‌ی کوچک برای کشف‌های بزرگ</span><span class="edition">VOL. 01 <i>✳</i></span></header>
    @if (_lesson != null)
    {
        <main class="landing-grid">
            <section class="landing-copy">
                <div class="eyebrow"><span class="live-dot"></span> یادگیری، با ریتم تو</div>
                <h1>دانسته‌هات رو<br/>به <em>موسیقی</em><br/>تبدیل کن<span class="title-star">✧</span></h1>
                <p class="hero-description">هر مبحث یک ملودی‌ست. کشفش کن، نت‌هاش رو کنار هم بذار و آلبوم خودت رو بساز.</p>
                <div class="lesson-picker"><span class="lesson-icon">❀</span><div><small>آلبوم این سفر</small><strong>@_lesson.Name</strong></div><span class="lesson-track-count">۵ قطعه <span>↗</span></span></div>
                <button class="button primary start-game" disabled="@_busy" @onclick="Start"><span>@(_busy ? "در حال ساخت آلبوم…" : "شروع یک ملودی تازه")</span><b>←</b></button>
                @if (_lesson.ResumeSessionId.HasValue) { <a class="resume-link" href="/game/@_lesson.ResumeSessionId">ادامه‌ی آلبوم قبلی <span>↗</span></a> }
                <div class="landing-promise"><span>♪ بدون زمان‌سنج</span><span>✧ فرصت برای دوباره یادگرفتن</span></div>
            </section>
            <section class="landing-art" aria-label="پیش‌نمایش صفحه موسیقی">
                <div class="art-label"><span>YOUR KNOWLEDGE.<br/>YOUR OWN SOUND.</span><svg viewBox="0 0 90 35"><path d="M2 3 Q20 36 78 23 M68 14 L80 24 L68 31"/></svg></div>
                <MusicDisc Topics="_lesson.Topics" Preview="true"/>
                <div class="floating-note note-a"><span>♪</span> هر پاسخ، یک نت تازه</div><div class="floating-note note-b">✦ <span>کشف کن. بساز. بدرخش.</span></div>
                <div class="disc-caption"><span class="equalizer"><i></i><i></i><i></i><i></i></span><span>صدای دنیای زنده</span><small>۵ مبحث · یک آلبوم</small></div>
            </section>
        </main>
        <section class="how-it-plays"><div><span>01</span><strong>کشف کن</strong><p>با چند سؤال کوتاه، نت‌های تازه پیدا کن.</p></div><i>⤳</i><div><span>02</span><strong>ملودی بساز</strong><p>با یک چالش، قطعه‌ات رو کامل کن.</p></div><i>⤳</i><div><span>03</span><strong>صیقل بده</strong><p>برگرد و خش‌های کوچیک رو به درخشش تبدیل کن.</p></div></section>
    }
    else if (_error == null) { <div class="empty-state">♪ در حال کوک‌کردن سازها…</div> }
    @if (_error != null) { <div class="error-notice" role="alert">@_error <button @onclick="Load">تلاش دوباره</button></div> }
    <footer class="studio-footer"><span>ساخته‌شده برای لذتِ فهمیدن</span><span>LEARN A LITTLE. MAKE A LITTLE MAGIC. ✦</span></footer>
</div>
@code {
    private LessonDto? _lesson;
    private string? _error;
    private bool _busy;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { try { _error = null; _lesson = await Engine.GetLessonAsync(); } catch (Exception) { _error = "آلبوم بارگذاری نشد. لطفاً دوباره امتحان کن."; } }
    private async Task Start()
    {
        if (_busy || _lesson == null) return;
        _busy = true;
        try { var state = await Engine.StartSessionAsync(_lesson.Id); Navigation.NavigateTo($"/game/{state.SessionId}"); }
        catch (Exception) { _error = "شروع بازی ممکن نشد؛ دوباره تلاش کن."; }
        finally { _busy = false; }
    }
}
