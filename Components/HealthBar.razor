@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="health-system @RangeClass @FeedbackClass @(IsLevelComplete ? "level-full" : "")" aria-label="سلامت" role="meter"
     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(Health)">
    <div class="health-header"><span>سلامت · @Difficulty.Label()</span><strong>@Math.Round(Health) / 100</strong></div>
    <div class="health-track"><div @ref="_fill" class="health-fill"></div></div>
    @if (Delta is not null)
    {
        <b @key="PulseKey" class="health-delta">@(Delta > 0 ? "+" : "")@Math.Round(Delta.Value)</b>
    }
</div>

@code {
    [Parameter] public double Health { get; set; } = 70;
    [Parameter] public double? Delta { get; set; }
    [Parameter] public int PulseKey { get; set; }
    [Parameter] public bool IsCorrectFeedback { get; set; }
    [Parameter] public bool IsLevelComplete { get; set; }
    [Parameter] public GameDifficulty Difficulty { get; set; }

    private ElementReference _fill;
    private IJSObjectReference? _module;
    private string? _controllerId;
    private readonly TaskCompletionSource _ready = new(TaskCreationOptions.RunContinuationsAsynchronously);
    private string RangeClass => Health <= 0 ? "depleted" : Health < 25 ? "critical" : Health < 50 ? "warning" : "healthy";
    private string FeedbackClass => Delta is null ? "" : IsCorrectFeedback ? "health-positive" : "health-negative";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/healthBar.js");
        _controllerId = await _module.InvokeAsync<string>("initializeHealthBar", _fill, Health);
        _ready.TrySetResult();
    }

    public async Task BeginQuestionAsync(double health, double decayPerSecond, int gracePeriodMs)
    {
        await _ready.Task;
        await _module!.InvokeVoidAsync("beginQuestion", _controllerId, health, decayPerSecond, gracePeriodMs);
    }

    public async Task<double> GetActiveElapsedMsAsync()
    {
        await _ready.Task;
        return await _module!.InvokeAsync<double>("getActiveElapsedMs", _controllerId);
    }

    public async Task<double> StopQuestionAsync()
    {
        await _ready.Task;
        return await _module!.InvokeAsync<double>("stopQuestion", _controllerId);
    }

    public async Task SetHealthAsync(double health, bool positive)
    {
        await _ready.Task;
        await _module!.InvokeVoidAsync("setHealth", _controllerId, health, positive);
    }

    public async Task PlayLevelCompleteAsync()
    {
        await _ready.Task;
        await _module!.InvokeVoidAsync("playLevelComplete", _controllerId);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _controllerId is not null)
                await _module.InvokeVoidAsync("disposeHealthBar", _controllerId);
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
