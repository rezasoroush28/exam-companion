@inject IJSRuntime JS
@implements IAsyncDisposable

<canvas @ref="_canvas" class="recovery-canvas" aria-label="فضای مکعبی بازیابی"></canvas>

@code {
    [Parameter] public EventCallback<long> HintThreshold { get; set; }
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RecoverySpace>? _self;
    private readonly TaskCompletionSource _ready = new(TaskCreationOptions.RunContinuationsAsynchronously);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/recoverySpace.js");
        await _module.InvokeVoidAsync("initialize", _canvas, _self);
        _ready.TrySetResult();
    }

    public async Task BeginQuestionAsync(double stability, string correctOption)
    {
        await _ready.Task;
        await _module!.InvokeVoidAsync("beginQuestion", stability, $"recovery-answer-{correctOption}");
    }

    public async Task<long> StopQuestionAsync()
    {
        await _ready.Task;
        return await _module!.InvokeAsync<long>("stopQuestion");
    }

    public async Task ShowCorrectAsync(double stability)
    {
        await _ready.Task;
        await _module!.InvokeVoidAsync("showCorrect", stability);
    }

    public async Task ShowIncorrectAsync()
    {
        await _ready.Task;
        await _module!.InvokeVoidAsync("showIncorrect");
    }

    public async Task CompleteTopicAsync()
    {
        await _ready.Task;
        await _module!.InvokeVoidAsync("completeTopic");
    }

    [JSInvokable]
    public Task OnHintThreshold(long elapsed) => HintThreshold.InvokeAsync(elapsed);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null) await _module.InvokeVoidAsync("dispose");
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
